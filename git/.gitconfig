[user]
  email = hristo.goumnerov@kbc.com
  name = JF82788

[alias]
  bl = blame -w --
  br = branch
  cm = commit
  lg = log --graph --oneline --abbrev-commit --decorate --pretty=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(auto)%d%C(reset)' --all
  lga = lg-specific --all
  lg-specific = log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold cyan)%aI%C(reset) %C(bold green)(%ar)%C(reset)%C(auto)%d%C(reset)%n''          %C(white)%s%C(reset) %C(dim white)- %an%C(reset)'
  log = log --follow
  logd = "-c diff.external=difft log -p --ext-diff"
  rh = reset --hard
  st = status

[branch]
  sort = -committerdate

[core]
  pager = delta

[delta]
  dark = true
  navigate = true
  side-by-side = false
  line-numbers = true

[diff]
  colorMoved = default
  tool = difft
  external = difft

[difftool]
  prompt = false

[difftool "difftastic"]
  cmd = difft "$LOCAL" "$REMOTE"

[commit]
  verbose = true

[fetch]
  prune = true
  pruneTags = true
  all = true

[interactive]
  diffFilter = delta --color-only

[merge]
  conflictStyle = zdiff3

[pull]
  rebase = true

[push]
  default = simple
  autoSetupRemote = true
  followTags = true

[pager]
  difftool = true

[rebase]
  autoSquash = true
  autoStash = true
  updateRefs = true

[tag]
  sort = version:refname
